# Rendered by chezmoi: edit with `chezmoi edit ~/.gitconfig`, not `git config --global`.
[user]
	name = {{ .name | quote }}
	email = {{ .email | quote }}

[core]
	editor = nvim
	pager = delta

[interactive]
	diffFilter = delta --color-only

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[delta]
	line-numbers = true
	features = decorations
	whitespace-error-style = 22 reverse
	side-by-side = false
	navigate = false

[delta "decorations"]
	commit-decoration-style = bold yellow box ul
	file-style = bold yellow ul
	file-decoration-style = none

# git asks gh for HTTPS credentials (what `gh auth setup-git` would write; run_after_50-gh-auth logs gh in).
# The work laptop isn't logged in to the personal github.com account.
{{- $hosts := list }}
{{- if ne .profile "work" }}{{ $hosts = list "github.com" "gist.github.com" }}{{ end }}
{{- if .github.enterpriseHost }}{{ $hosts = append $hosts .github.enterpriseHost }}{{ end }}
{{- range $hosts }}
[credential "https://{{ . }}"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
{{- end }}

{{- if eq .profile "work" }}

# Work: push this repo with a fine-grained token scoped to it, kept in its own Keychain item
# (README "Work laptop"). `helper =` drops the system osxkeychain, which would store the token for
# all of github.com. The path match is exact: the remote must end in `.git`.
[credential "https://github.com/christopher-francisco/vizion-2.git"]
	helper =
	helper = "!f() { test \"$1\" = get || exit 0; t=$(security find-generic-password -s vizion-2-push -w 2>/dev/null) || exit 0; echo username=christopher-francisco; echo password=$t; }; f"
	useHttpPath = true
{{- end }}

# Per-machine delta toggles written by the dnav/dnonav/dvsp/dsp aliases; not managed by chezmoi.
[include]
	path = ~/.config/git/delta-toggles
