#!/usr/bin/expect -f
# ssh-password.exp <user@host> <password> <command>: runs one command over SSH with a password
# login (used once per VM, to install the test key).
lassign $argv target password command
set timeout 60
log_user 0
spawn ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o PubkeyAuthentication=no $target $command
expect {
  -re {assword:} { send "$password\r"; exp_continue }
  timeout { exit 1 }
  eof
}
catch wait result
exit [lindex $result 3]
