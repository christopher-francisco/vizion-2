{{- /* First-run prompts. Answers are stored in ~/.config/chezmoi/chezmoi.toml; re-ask with `chezmoi init --prompt`. */ -}}
{{- $profile := promptChoiceOnce . "profile" "Machine profile" (list "personal" "work") -}}
{{- $isWork := eq $profile "work" -}}
# Keep using the clone this machine was initialised from (e.g. `chezmoi init --source ~/Developer/code/vizion-2`).
sourceDir = {{ .chezmoi.sourceDir | quote }}

[data]
  profile = {{ $profile | quote }}
  name = {{ promptStringOnce . "name" "Git name" | quote }}
  email = {{ promptStringOnce . "email" "Git email for this machine" | quote }}
  {{- /* The colour scheme of iTerm's default profile, tmux and Neovim: the machine's own. A window opened
  with another iTerm profile brings its scheme to tmux and Neovim (docs/requirements/0.3.0_COLOUR_SCHEME_SYNC.md).
  Choices: the iTerm theme profiles. Default: the answer to the question this replaced, iterm.theme. */}}
  {{- $profilesJson := joinPath .chezmoi.sourceDir "linked/iterm2/DynamicProfiles/*.json" | glob }}
  {{- $themes := list }}
  {{- range $profilesJson }}
  {{-   range (include . | fromJson).Profiles }}
  {{-     if eq (get . "Dynamic Profile Parent Name") "Base" }}{{ $themes = append $themes (lower .Name) }}{{ end }}
  {{-   end }}
  {{- end }}
  {{- $themes = $themes | sortAlpha | uniq }}
  {{- $oldTheme := dig "iterm" "theme" "" . }}
  theme = {{ promptChoiceOnce . "theme" "Colour scheme (iTerm, tmux, Neovim)" $themes (ternary $oldTheme "tokyonight" (has $oldTheme $themes)) | quote }}
  [data.groups]
    core = true
    dev = true
    {{- $gui := promptBoolOnce . "groups.gui" "Install GUI apps (iTerm, VS Code, Karabiner…)" true }}
    gui = {{ $gui }}
    personal = {{ promptBoolOnce . "groups.personal" "Install personal apps (1Password, Spotify, Blender…)" (not $isWork) }}
    mas = {{ promptBoolOnce . "groups.mas" "Install Mac App Store apps (needs Apple ID sign-in)" (not $isWork) }}
    {{- $enterprise := promptBoolOnce . "groups.enterprise" "Log gh in to a GitHub Enterprise host" $isWork }}
    enterprise = {{ $enterprise }}
  [data.github]
    enterpriseHost = {{ if $enterprise }}{{ promptStringOnce . "github.enterpriseHost" "GitHub Enterprise host (e.g. github.example.com)" | quote }}{{ else }}""{{ end }}
  [data.machine]
    crowdstrike = {{ promptBoolOnce . "machine.crowdstrike" "Is CrowdStrike installed (inline tmux navigator bindings)" $isWork }}
  [data.iterm]
    {{- /* iTerm's default profile, "This Mac", inherits from the size profile of the colour scheme (theme)
    tagged with this monitor, the smaller or bigger of its two (ADR 0006). Monitors are read from the profiles. */}}
    {{- $monitors := list }}
    {{- range $profilesJson }}
    {{-   range (include . | fromJson).Profiles }}
    {{-     if and (ne (get . "Dynamic Profile Parent Name") "Base") (hasKey . "Normal Font") }}{{ $monitors = concat $monitors (rest .Tags) }}{{ end }}
    {{-   end }}
    {{- end }}
    {{- $monitors = $monitors | sortAlpha | uniq }}
    monitor = {{ if $gui }}{{ promptChoiceOnce . "iterm.monitor" "Main monitor (iTerm's default profile)" $monitors (ternary "4k" "retina" $isWork) | quote }}{{ else }}""{{ end }}
    size = {{ if $gui }}{{ promptChoiceOnce . "iterm.size" "Font size on that monitor" (list "small" "big") "big" | quote }}{{ else }}""{{ end }}

[git]
  autoCommit = {{ not $isWork }}
  autoPush = {{ not $isWork }}
