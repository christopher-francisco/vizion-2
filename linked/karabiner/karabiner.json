                                "from": {
                                    "key_code": "v",
                                    "modifiers": { "mandatory": ["control", "option", "command"] }
                                },
                                "to": [{ "shell_command": "cd ~ && /opt/homebrew/bin/code -n" }],
                                "type": "basic"
                            }
                        ]
