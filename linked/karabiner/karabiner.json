{
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Ctrl+Opt+Cmd+N: Neovide scratch window (vizion-2 0.6.0_GUI_EDITORS)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "n",
                                    "modifiers": { "mandatory": ["control", "option", "command"] }
                                },
                                "to": [{ "shell_command": "cd ~ && if pgrep -xq neovide; then /opt/homebrew/bin/neovide --reuse-instance --new-window; else open -a Neovide; fi" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Ctrl+Opt+Cmd+V: VS Code window with an untitled file (vizion-2 0.6.0_GUI_EDITORS)",
                        "manipulators": [
