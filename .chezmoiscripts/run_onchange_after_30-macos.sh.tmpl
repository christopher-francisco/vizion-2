#!/bin/bash
# macOS settings: terminfo entries for italics/true colour, iTerm2's prefs folder and the
# `defaults write` settings of each enabled group (.chezmoidata/macos.yaml). chezmoi re-runs this
# script whenever its rendered content or a terminfo file changes. Quit iTerm2 before it runs, or
# iTerm overwrites its settings on quit.
{{- range $f := list "xterm-256color-italic" "tmux-256color" }}
# {{ $f }}: {{ include (printf "linked/iterm2/terminfo/%s.terminfo" $f) | sha256sum }}
{{- end }}
set -euo pipefail

# Compiled into ~/.terminfo
for f in xterm-256color-italic tmux-256color; do
  tic -x "{{ .chezmoi.sourceDir }}/linked/iterm2/terminfo/$f.terminfo"
done
{{- if .groups.gui }}

# iTerm2 reads (and writes) its settings in the repo's linked/iterm2 folder
defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
defaults write com.googlecode.iterm2 PrefsCustomFolder -string {{ printf "%s/linked/iterm2" .chezmoi.sourceDir | quote }}
{{- end }}
{{- range $group, $settings := .macos.defaults }}{{ if index $.groups $group }}

# {{ $group }}
{{- range $settings }}
defaults write {{ .domain | quote }} {{ .key | quote }} -{{ .type }} {{ .value | toString | quote }}
{{- end }}
{{- end }}{{ end }}
