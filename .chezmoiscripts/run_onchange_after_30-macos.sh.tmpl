#!/bin/bash
# macOS settings: iTerm2's prefs folder and the `defaults write` settings of each enabled group
# (.chezmoidata/macos.yaml). chezmoi re-runs this script whenever its rendered content changes. No
# terminfo entries: macOS's own xterm-256color and tmux-256color have italics (ADR 0009). iTerm2
# settings (other than NoSync* and the prefs-folder keys) belong in linked/iterm2's plist: at launch
# iTerm replaces them all with the plist's values, so one written here while iTerm is quit only lasts
# if the plist has it too; while iTerm runs, iTerm saves it into the plist on quit.
set -euo pipefail
{{- if .groups.gui }}

# iTerm2 reads (and writes) its settings in the repo's linked/iterm2 folder
defaults write com.googlecode.iterm2 LoadPrefsFromCustomFolder -bool true
defaults write com.googlecode.iterm2 PrefsCustomFolder -string {{ printf "%s/linked/iterm2" .chezmoi.sourceDir | quote }}
# and saves a copy of every dynamic profile into the plist, which git strips (ADR 0008, .gitattributes)
git -C {{ .chezmoi.sourceDir | quote }} config filter.iterm-plist.clean bin/iterm-plist-clean.sh
git -C {{ .chezmoi.sourceDir | quote }} config filter.iterm-plist.required true
{{- end }}
{{- range $group, $settings := .macos.defaults }}{{ if index $.groups $group }}

# {{ $group }}
{{- range $settings }}
defaults write {{ .domain | quote }} {{ .key | quote }} -{{ .type }} {{ .value | toString | quote }}
{{- end }}
{{- end }}{{ end }}
