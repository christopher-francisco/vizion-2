{{- $hosts := list }}
{{- if ne .profile "work" }}{{ $hosts = append $hosts "github.com" }}{{ end }}
{{- if .github.enterpriseHost }}{{ $hosts = append $hosts .github.enterpriseHost }}{{ end }}
{{- if $hosts -}}
#!/bin/bash
# Logs gh in to each GitHub host this machine uses, over HTTPS. gh keeps the tokens in the macOS
# Keychain; git gets them through the credential helpers in ~/.gitconfig. Runs once per host list.
set -euo pipefail

eval "$(/opt/homebrew/bin/brew shellenv)"

for host in{{ range $hosts }} {{ . | quote }}{{ end }}; do
  # Ignore token env vars: only a stored login survives a new shell.
  if env -u GITHUB_TOKEN -u GH_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN \
      gh auth status --hostname "$host" >/dev/null 2>&1; then
    echo "gh: already logged in to $host"
  elif [ -t 0 ]; then
    env -u GITHUB_TOKEN -u GH_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN \
      gh auth login --hostname "$host" --git-protocol https --web
  else
    echo "gh: not logged in to $host; run: gh auth login --hostname $host --git-protocol https --web" >&2
  fi
done
{{ end -}}
